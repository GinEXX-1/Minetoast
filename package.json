{
  "name": "minetoast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "dev": "cross-env DATABASE_MODE=pglite node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:postgres": "cross-env DATABASE_MODE=postgres node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx apps/api/src/start.ts",
    "start:local": "cross-env DATABASE_MODE=pglite node --env-file-if-exists=.env --import tsx apps/api/src/start.ts",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-db.ts",
    "db:setup:local": "cross-env DATABASE_MODE=pglite node --env-file-if-exists=.env --import tsx scripts/setup-db.ts",
    "test": "vitest run",
    "test:pg": "cross-env DATABASE_MODE=postgres vitest run tests/integration",
    "test:pg:isolated": "node --import tsx scripts/test-postgres.ts",
    "test:install": "node --import tsx scripts/check-install.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/admin-account.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --host 0.0.0.0 --port 4173",
    "assets:mathcraft": "node --import tsx scripts/export-mathcraft-icons.ts",
    "ponder:validate": "node --import tsx scripts/ponder-gate.ts --validate-only",
    "ponder:gate": "node --import tsx scripts/ponder-gate.ts",
    "ponder:storyboard": "node --import tsx scripts/ponder-storyboard.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.3",
    "@node-rs/argon2": "2.2.0",
    "@tanstack/react-query": "5.102.8",
    "@xyflow/react": "12.11.6",
    "elkjs": "0.11.1",
    "fastify": "5.12.3",
    "katex": "0.16.47",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/katex": "0.16.8",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
