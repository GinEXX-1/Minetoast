{
  "name": "knowledge-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e",
    "dev": "cross-env DATABASE_MODE=pglite node --import tsx scripts/dev.ts",
    "dev:postgres": "cross-env DATABASE_MODE=postgres node --import tsx scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx apps/api/src/start.ts",
    "start:local": "cross-env DATABASE_MODE=pglite node --import tsx apps/api/src/start.ts",
    "db:setup": "node --import tsx scripts/setup-db.ts",
    "db:setup:local": "cross-env DATABASE_MODE=pglite node --import tsx scripts/setup-db.ts",
    "test": "vitest run",
    "test:pg": "cross-env DATABASE_MODE=postgres vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/react-query": "^5.90.2",
    "@xyflow/react": "^12.8.5",
    "elkjs": "^0.11.0",
    "fastify": "^5.6.1",
    "katex": "^0.16.22",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "cross-env": "^10.0.0",
    "eslint": "^10.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
