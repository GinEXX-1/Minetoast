# Standard runtime: configure a real PostgreSQL database, then pnpm db:setup.
DATABASE_MODE=postgres
DATABASE_URL=postgresql://knowledge:knowledge_local_only@localhost:5432/knowledge_world
APP_ORIGIN=http://localhost:4173
PORT=4174
# Explicit local fallback only: pnpm dev:local uses server-side PGlite disk storage.
PGLITE_DIR=.data/knowledge-world
